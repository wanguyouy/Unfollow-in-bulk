{
  "name": "bilibili-unfollow-app",
  "productName": "B站一键取关助手",
  "version": "1.0.0",
  "description": "Bilibili 一键取关桌面应用(Electron)",
  "main": "main.js",
  "author": "local",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "node-forge": "^1.4.0"
  },
  "build": {
    "appId": "com.local.bilibili-unfollow",
    "productName": "B站一键取关助手",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "emoji-export.js",
      "douyin-images.js",
      "douyin-fetch.js",
      "alipay-fetch.js",
      "wechat-article.js",
      "telegram-fetch.js",
      "telegram-local.js",
      "telegram-session.js",
      "telegram-mtproto.js",
      "telegram-authkey.js",
      "telegram-dl.js",
      "wx-proxy.js",
      "wxv-collect.js",
      "wxv-decrypt.js",
      "renderer/**/*"
    ],
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
